# ── Rust ────────────────────────────────────────────────────────────────────
# Build output. Cargo.lock stays tracked: this workspace ships a binary.
/target/
**/*.rs.bk
*.pdb
rustc-ice-*.txt
**/mutants.out*/

# ── The lab ─────────────────────────────────────────────────────────────────
# The console writes every host's cells, control.db, replicas, autumn.toml,
# pid and host.log under ./murmuration-lab of whatever directory it runs in
# (repo root or crates/murmuration-app). Set MURMURATION_LAB elsewhere and
# you own ignoring it.
murmuration-lab/

# Stray SQLite files and their journals, wherever a run left them.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# ── Verus ───────────────────────────────────────────────────────────────────
.verus-log/
.verus-solver-log/

# ── Python (tools/drill.py) ─────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── Secrets and local overrides ─────────────────────────────────────────────
# AUTUMN_SECURITY__SIGNING_SECRET belongs in the environment, never a file here.
.env
.env.*
autumn-local.toml

# ── Editors and OS ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
